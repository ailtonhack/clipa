# Copy to .env and supply your values. Never put credentials in frontend files.
CLIPA_BASE_URL=http://localhost:8000
CLIPA_PASSWORD=
OPENAI_API_KEY=
# Optional: leave blank locally to generate a persistent key in data/credential.key.
# In a container, persist /app/data. Losing the key invalidates connected accounts.
CLIPA_ENCRYPTION_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
META_CLIENT_ID=
META_CLIENT_SECRET=
